rules_version = '2';

// =====================================================
// Who can read and write what in Firestore.
// Deploy with:  npx firebase-tools deploy --only firestore:rules
// =====================================================
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function text(v, max) { return v is string && v.size() <= max; }
    // Photos are Storage URLs, small SVG drawings, or (without a Storage bucket) small inline JPEGs
    function photo(v) { return v is string && v.size() <= 600000; }
    function category(v) { return v in ['top', 'bottom', 'dress', 'shoes', 'outerwear', 'accessory']; }

    // Friendship ids are the two uids, sorted and joined with "_"
    function friendshipId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function areFriends(a, b) {
      let path = /databases/$(database)/documents/friendships/$(friendshipId(a, b));
      return exists(path) && get(path).data.status == 'accepted';
    }

    // ---------- Each person's own data (wardrobe, outfits, karma, settings, invite code) ----------
    match /users/{uid} {
      allow read, write: if isUser(uid);
      match /{document=**} {
        allow read, write: if isUser(uid);
      }
    }

    // ---------- Invite codes: { uid, displayName, photoURL } ----------
    // Any signed-in member can look up a code they know, but codes can't be listed.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && code.matches('^[A-Z0-9]{6}$');
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid
        && (request.method == 'delete' || request.resource.data.uid == request.auth.uid);
    }

    // ---------- Friendships: members [a, b], status, requestedBy, profiles ----------
    match /friendships/{id} {
      allow get: if signedIn()
        && (resource == null ? id.split('_').hasAny([request.auth.uid])
                             : request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && id == friendshipId(request.resource.data.members[0], request.resource.data.members[1])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      // Only the person who was asked can accept; members can't change
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.members == resource.data.members
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.status == 'accepted';

      // Either member can decline a request or remove the friendship
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // ---------- Listings (id = "{uid}_{key}") ----------
    //   public: true            community swap feed — every signed-in member can browse
    //   sharedWithFriends: true only the owner's accepted friends can see it
    // Only the owner can add, change or remove their own.
    match /listings/{listingId} {
      function ownsId() { return listingId.matches(request.auth.uid + '_.+'); }

      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || resource.data.public == true
            || (resource.data.sharedWithFriends == true && areFriends(request.auth.uid, resource.data.ownerUid)));

      allow delete: if signedIn() && ownsId();

      allow create, update: if signedIn() && ownsId()
        && request.resource.data.ownerUid == request.auth.uid
        && text(request.resource.data.title, 60)
        && request.resource.data.type in ['sell', 'swap', 'lend']
        && (
          // community listing (one wardrobe item marked "Available to swap")
          (request.resource.data.public == true
            && listingId == request.auth.uid + '_' + request.resource.data.itemId
            && text(request.resource.data.ownerName, 40)
            && category(request.resource.data.category)
            && photo(request.resource.data.photo))
          // shared with friends (small JPEG thumbnail)
          || (request.resource.data.public == false
            && request.resource.data.sharedWithFriends == true
            && request.resource.data.thumbnail is string
            && request.resource.data.thumbnail.size() <= 153600)
        );
    }

    // ---------- Community swap requests: only the two members involved can see them ----------
    //   pending -> accepted / declined (by the listing owner) -> completed (by either)
    match /swapRequests/{requestId} {
      function involved() {
        return signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      }
      allow read: if involved();
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && text(request.resource.data.fromName, 40)
        && photo(request.resource.data.offered.photo)
        && photo(request.resource.data.listing.photo)
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerUid == request.resource.data.toUid;
      allow update: if involved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          (resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'declined'] && resource.data.toUid == request.auth.uid)
          || (resource.data.status == 'accepted' && request.resource.data.status == 'completed')
        );
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // ---------- Friends' borrow / swap requests (with messages) ----------
    match /requests/{id} {
      function friendInvolved(data) {
        return request.auth.uid == data.ownerUid || request.auth.uid == data.requesterUid;
      }

      allow read: if signedIn() && friendInvolved(resource.data);

      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.type in ['borrow', 'swap']
        && request.resource.data.status == 'pending'
        && areFriends(request.auth.uid, request.resource.data.ownerUid);

      // Both people can add messages; only the owner can accept or decline
      allow update: if signedIn()
        && friendInvolved(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'status'])
        && (request.resource.data.status == resource.data.status
            || (request.auth.uid == resource.data.ownerUid
                && request.resource.data.status in ['accepted', 'declined']));

      allow delete: if false;
    }
  }
}
