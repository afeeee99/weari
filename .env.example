# Copy this file to .env and fill it in. .env is ignored by git, so it is never uploaded.

# ---------- Gemini (AI stylist) ----------
GEMINI_API_KEY=
# true = fake AI answers for testing (no Gemini quota used)
MOCK_GEMINI=false

# ---------- Firebase (sign-in, cloud sync, community swaps) ----------
# Firebase Console → Project settings → General → Your apps → Web app → "SDK setup and configuration" → Config.
# These values are safe to show in a browser (security comes from firebase/firestore.rules),
# but keep them here so each environment can use its own project.
# Leave FIREBASE_API_KEY empty to run in on-device mode (no sign-in).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
