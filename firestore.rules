rules_version = '2';

// Weari: friends, shared listings and borrow/swap requests.
// Not deployed automatically. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Friendship ids are the two uids, sorted and joined with "_"
    function friendshipId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function areFriends(a, b) {
      let path = /databases/$(database)/documents/friendships/$(friendshipId(a, b));
      return exists(path) && get(path).data.status == 'accepted';
    }

    // users/{uid}: only the owner can read or write their own doc
    match /users/{uid} {
      allow read, write: if isMe(uid);
    }

    // inviteCodes/{code}: { uid, displayName, photoURL }
    // Any signed-in user can look up a code they know, but codes can't be listed.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && code.matches('^[A-Z0-9]{6}$');
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid
        && (request.method == 'delete' || request.resource.data.uid == request.auth.uid);
    }

    // friendships/{a_b}: members [a, b], status, requestedBy, profiles
    match /friendships/{id} {
      allow get: if signedIn()
        && (resource == null ? id.split('_').hasAny([request.auth.uid])
                             : request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && id == friendshipId(request.resource.data.members[0], request.resource.data.members[1])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      // Only the person who was asked can accept; members can't change
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.members == resource.data.members
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.status == 'accepted';

      // Either member can decline a request or remove the friendship
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // listings/{id}: readable by the owner and accepted friends; only the owner writes
    match /listings/{id} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || (resource.data.sharedWithFriends == true && areFriends(request.auth.uid, resource.data.ownerUid)));

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.type in ['sell', 'swap', 'lend']
        && request.resource.data.thumbnail is string
        && request.resource.data.thumbnail.size() <= 153600;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.thumbnail.size() <= 153600;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // requests/{id}: only the owner and the requester can read or write
    match /requests/{id} {
      function involved(data) {
        return request.auth.uid == data.ownerUid || request.auth.uid == data.requesterUid;
      }

      allow read: if signedIn() && involved(resource.data);

      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.type in ['borrow', 'swap']
        && request.resource.data.status == 'pending'
        && areFriends(request.auth.uid, request.resource.data.ownerUid);

      // Both people can add messages; only the owner can accept or decline
      allow update: if signedIn()
        && involved(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'status'])
        && (request.resource.data.status == resource.data.status
            || (request.auth.uid == resource.data.ownerUid
                && request.resource.data.status in ['accepted', 'declined']));

      allow delete: if false;
    }
  }
}
